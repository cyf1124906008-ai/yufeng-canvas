{
  "name": "yufeng-canvas",
  "productName": "YUFENG Agent",
  "private": true,
  "version": "1.3.1",
  "description": "Local desktop Agent Harness with workspace, terminal, computer-control and creative tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyf1124906008-ai/yufeng-canvas.git"
  },
  "yufeng": {
    "updateMirrors": []
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:agent": "node --test tests/agent-core.test.js tests/model-router.test.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "web:dev": "vite",
    "web:build": "vite build",
    "desktop:renderer": "cross-env APP_TARGET=desktop vite build",
    "desktop:dev": "concurrently -k \"cross-env APP_TARGET=desktop vite\" \"wait-on tcp:5173 && cross-env APP_TARGET=desktop ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:start": "cross-env APP_TARGET=desktop electron .",
    "desktop:build": "pnpm desktop:renderer && electron-builder --dir",
    "desktop:dist": "pnpm desktop:dist:win",
    "desktop:dist:win": "pnpm desktop:renderer && electron-builder --win nsis --x64",
    "desktop:dist:mac": "pnpm desktop:renderer && electron-builder --mac dmg zip --arm64 --x64",
    "desktop:dist:mac:arm64": "pnpm desktop:renderer && electron-builder --mac dmg zip --arm64",
    "desktop:dist:mac:x64": "pnpm desktop:renderer && electron-builder --mac dmg zip --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^5.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "ai.yufeng.canvas",
    "productName": "YUFENG Agent",
    "icon": "build/icon.ico",
    "artifactName": "YUFENG-Agent-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cyf1124906008-ai",
        "repo": "yufeng-canvas"
      }
    ],
    "files": [
      "dist-desktop/**/*",
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "YUFENG-Agent-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "YUFENG Agent ${version}",
      "artifactName": "YUFENG-Agent-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
